# Copy to .env.local for local runs. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.
# The site still runs with any of these left blank: sign-in and account storage just stay off.

# Clerk (dashboard.clerk.com → your app → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (supabase.com → your project → Project Settings → API / API Keys)
# Use the project URL and the SECRET key (sb_secret_... or the legacy service_role key).
# It is only read on the server; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI providers for Ask and Review (tried in order 1 → 4)
ASK_LLM_1_KEY=
ASK_LLM_1_MODEL=
ASK_LLM_2_KEY=
ASK_LLM_2_MODEL=
ASK_LLM_3_KEY=
ASK_LLM_3_MODEL=
# DeepSeek keys start with sk-, so give its base URL explicitly:
# ASK_LLM_3_BASE_URL=https://api.deepseek.com/v1
